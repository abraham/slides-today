{
  "name": "slides-today",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22",
    "npm": "11"
  },
  "scripts": {
    "build": "ng build",
    "build:development": "npm run build -- --configuration development",
    "build:scripts": "cd scripts && tsc",
    "build:stats": "npm run build -- --stats-json",
    "bundlesize": "bundlesize --enable-github-checks",
    "clean": "rm -rf dist && rm -rf scripts/dist",
    "deploy": "firebase deploy",
    "fix": "concurrently npm:fix:*",
    "fix:ng": "ng lint --fix",
    "fix:prettier": "prettier --write .",
    "get-tweet": "ts-node --project scripts/tsconfig.json scripts/get-tweet.ts",
    "id": "ts-node --project scripts/tsconfig.json scripts/id.ts",
    "lighthouse": "firebase emulators:exec \"lhci autorun\"",
    "lint": "concurrently npm:lint:*",
    "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts npm github.com",
    "lint:ng": "ng lint",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"src/**/*.scss\"",
    "ng": "ng",
    "prebuild": "npm run clean",
    "prebuild:scripts": "cp -n example.twitter.json .twitter.json || true; cp -n example.firebase-adminsdk.json .firebase-adminsdk.json || true",
    "serve": "npm run build && npm run start:firebase",
    "start": "ng serve --port 5000 --hmr",
    "start:firebase": "firebase emulators:start",
    "test": "NODE_OPTIONS='--loader ts-node/esm' TS_NODE_PROJECT=features/tsconfig.loose.json cucumber-js",
    "test:features": "start-server-and-test start:firebase http://127.0.0.1:5000/ test",
    "test:unit": "ng test --watch=false",
    "update-tweets": "ts-node --project scripts/tsconfig.json scripts/update-tweets.ts",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@justinribeiro/lite-youtube": "1.9.0",
    "firebase": "^12.19.0",
    "first-input-delay": "0.1.3",
    "github-repository": "0.4.0",
    "material-components-web": "14.0.0",
    "ngx-skeleton-loader": "13.0.0",
    "node-package": "1.4.0",
    "rxjs": "7.8.2",
    "tslib": "^2.6.2",
    "twitter-status": "0.7.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.1",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/dom": "^10.4.1",
    "@types/chai": "5.2.3",
    "@types/node": "26.6.3",
    "@types/twit": "2.2.35",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "angular-eslint": "22.5.0",
    "bundlesize2": "^0.0.35",
    "chai": "6.2.2",
    "concurrently": "10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.0.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-react": "latest",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.27.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.2.1",
    "lockfile-lint": "5.0.1",
    "pptr-testing-library": "0.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-package": "2.0.0",
    "puppeteer": "^25.12.0",
    "sass": "1.105.1",
    "start-server-and-test": "3.0.12",
    "stylelint": "17.15.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.2.0",
    "ts-node": "10.9.2",
    "twit": "2.2.11",
    "twitter-d": "0.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "bundlesize": [
    {
      "path": "dist/slides-today/browser/*main-*.js",
      "maxSize": "250 kB"
    },
    {
      "path": "dist/slides-today/browser/chunk-*.js",
      "maxSize": "75 kB"
    },
    {
      "path": "dist/slides-today/browser/*.js",
      "maxSize": "25 kB"
    }
  ]
}
